@{
    Layout = "_Layout";
}

<div class="hero-section text-center text-white py-5 mb-5">
    <div class="container">
        <h1 class="display-4 fw-bold mb-3">Welcome to WoodCraft Furniture</h1>
        <p class="lead mb-4">Elegant, Classic & Modern Furniture for Your Home</p>
        <a href="@Url.Action("Index", "Products")" class="btn btn-light btn-lg px-4">Shop Now</a>
    </div>
</div>

<div class="container mb-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold">Featured Products</h2>
        <p class="text-muted">Handpicked pieces for your dream home</p>
    </div>
    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 product-card shadow-sm">
                    <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=500" : product.ImageUrl)" class="card-img-top" alt="@product.Name" style="height: 250px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text text-muted small">@product.Category</p>
                        <p class="card-text fw-bold text-primary fs-5">$@product.Price.ToString("F2")</p>
                        <div class="mt-auto">
                            <a href="@Url.Action("Details", "Products", new { id = product.ProductId })" class="btn btn-outline-primary btn-sm me-2">View Details</a>
                            <a href="@Url.Action("AddToCart", "Cart", new { productId = product.ProductId, productName = product.Name, imageUrl = product.ImageUrl, price = product.Price })" class="btn btn-primary btn-sm">Add to Cart</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="categories-section py-5 mb-5 bg-light">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="fw-bold">Shop by Category</h2>
        </div>
        <div class="row g-3">
            <div class="col-md-4 col-6">
                <a href="@Url.Action("Index", "Products", new { category = "Sofas" })" class="text-decoration-none">
                    <div class="category-card text-center p-4 bg-white shadow-sm">
                        <h5 class="mb-0">Sofas</h5>
                    </div>
                </a>
            </div>
            <div class="col-md-4 col-6">
                <a href="@Url.Action("Index", "Products", new { category = "Beds" })" class="text-decoration-none">
                    <div class="category-card text-center p-4 bg-white shadow-sm">
                        <h5 class="mb-0">Beds</h5>
                    </div>
                </a>
            </div>
            <div class="col-md-4 col-6">
                <a href="@Url.Action("Index", "Products", new { category = "Tables" })" class="text-decoration-none">
                    <div class="category-card text-center p-4 bg-white shadow-sm">
                        <h5 class="mb-0">Tables</h5>
                    </div>
                </a>
            </div>
            <div class="col-md-4 col-6">
                <a href="@Url.Action("Index", "Products", new { category = "Chairs" })" class="text-decoration-none">
                    <div class="category-card text-center p-4 bg-white shadow-sm">
                        <h5 class="mb-0">Chairs</h5>
                    </div>
                </a>
            </div>
            <div class="col-md-4 col-6">
                <a href="@Url.Action("Index", "Products", new { category = "Wardrobes" })" class="text-decoration-none">
                    <div class="category-card text-center p-4 bg-white shadow-sm">
                        <h5 class="mb-0">Wardrobes</h5>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>
