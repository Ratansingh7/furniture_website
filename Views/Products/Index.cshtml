@{
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold">Our Products</h2>
            @if (ViewBag.CurrentCategory != null)
            {
                <p class="text-muted">Category: @ViewBag.CurrentCategory</p>
            }
            @if (ViewBag.SearchString != null)
            {
                <p class="text-muted">Search results for: "@ViewBag.SearchString"</p>
            }
        </div>
        <div class="col-md-4">
            <form method="get" action="@Url.Action("Index")" class="d-flex">
                <input type="text" name="searchString" class="form-control me-2" placeholder="Search products..." value="@ViewBag.SearchString">
                <button type="submit" class="btn btn-primary">Search</button>
            </form>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="btn-group" role="group">
                <a href="@Url.Action("Index")" class="btn btn-outline-primary">All</a>
                <a href="@Url.Action("Index", new { category = "Sofas" })" class="btn btn-outline-primary">Sofas</a>
                <a href="@Url.Action("Index", new { category = "Beds" })" class="btn btn-outline-primary">Beds</a>
                <a href="@Url.Action("Index", new { category = "Tables" })" class="btn btn-outline-primary">Tables</a>
                <a href="@Url.Action("Index", new { category = "Chairs" })" class="btn btn-outline-primary">Chairs</a>
                <a href="@Url.Action("Index", new { category = "Wardrobes" })" class="btn btn-outline-primary">Wardrobes</a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @if (Model.Count == 0)
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted">No products found.</p>
            </div>
        }
        else
        {
            @foreach (var product in Model)
            {
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 product-card shadow-sm">
                        <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=500" : product.ImageUrl)" class="card-img-top" alt="@product.Name" style="height: 250px; object-fit: cover;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text text-muted small">@product.Category</p>
                            <p class="card-text">@product.Description.Substring(0, Math.Min(60, product.Description.Length))@(product.Description.Length > 60 ? "..." : "")</p>
                            <p class="card-text fw-bold text-primary fs-5">$@product.Price.ToString("F2")</p>
                            <div class="mt-auto">
                                <a href="@Url.Action("Details", new { id = product.ProductId })" class="btn btn-outline-primary btn-sm me-2">View Details</a>
                                <a href="@Url.Action("AddToCart", "Cart", new { productId = product.ProductId, productName = product.Name, imageUrl = product.ImageUrl, price = product.Price })" class="btn btn-primary btn-sm">Add to Cart</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
