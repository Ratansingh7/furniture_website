@{
    Layout = "_Layout";
}

<div class="container mt-4 mb-5">
    <h2 class="fw-bold mb-4">Shopping Cart</h2>

    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <p class="text-muted mb-4">Your cart is empty.</p>
            <a href="@Url.Action("Index", "Products")" class="btn btn-primary">Continue Shopping</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="table-responsive">
                    <table class="table">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=100" : item.ImageUrl)" alt="@item.ProductName" style="width: 80px; height: 80px; object-fit: cover;" class="me-3 rounded">
                                            <div>
                                                <h6 class="mb-0">@item.ProductName</h6>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="align-middle">$@item.Price.ToString("F2")</td>
                                    <td class="align-middle">
                                        <div class="d-flex align-items-center" style="width: 120px;">
                                            <a href="@Url.Action("UpdateQuantity", new { productId = item.ProductId, quantity = item.Quantity - 1 })" class="btn btn-sm btn-outline-secondary">-</a>
                                            <span class="mx-3">@item.Quantity</span>
                                            <a href="@Url.Action("UpdateQuantity", new { productId = item.ProductId, quantity = item.Quantity + 1 })" class="btn btn-sm btn-outline-secondary">+</a>
                                        </div>
                                    </td>
                                    <td class="align-middle fw-bold">$@item.Total.ToString("F2")</td>
                                    <td class="align-middle">
                                        <a href="@Url.Action("RemoveFromCart", new { productId = item.ProductId })" class="btn btn-sm btn-danger">Remove</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title mb-4">Order Summary</h5>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Subtotal</span>
                            <span>$@ViewBag.Total.ToString("F2")</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <strong>Total</strong>
                            <strong class="text-primary">$@ViewBag.Total.ToString("F2")</strong>
                        </div>
                        <button class="btn btn-primary w-100 mb-2">Proceed to Checkout</button>
                        <a href="@Url.Action("Index", "Products")" class="btn btn-outline-secondary w-100">Continue Shopping</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
