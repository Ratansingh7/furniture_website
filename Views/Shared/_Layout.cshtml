<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WoodCraft Furniture</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Home")">
                    <i class="bi bi-house-heart"></i> WoodCraft Furniture
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Products")">Products</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                Categories
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Products", new { category = "Sofas" })">Sofas</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Products", new { category = "Beds" })">Beds</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Products", new { category = "Tables" })">Tables</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Products", new { category = "Chairs" })">Chairs</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Products", new { category = "Wardrobes" })">Wardrobes</a></li>
                            </ul>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Cart")">
                                <i class="bi bi-cart"></i> Cart
                            </a>
                        </li>
                        @{
                            var userName = Context.Session.GetString("UserName");
                            var isAdmin = Context.Session.GetString("IsAdmin");
                        }
                        @if (string.IsNullOrEmpty(userName))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Login", "Account")">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Register", "Account")">Register</a>
                            </li>
                        }
                        else
                        {
                            @if (isAdmin == "True")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "Admin")">Admin</a>
                                </li>
                            }
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person"></i> @userName
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="@Url.Action("Logout", "Account")">Logout</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white mt-5 py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5>WoodCraft Furniture</h5>
                    <p class="small">Elegant furniture for modern living spaces.</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Quick Links</h6>
                    <ul class="list-unstyled">
                        <li><a href="@Url.Action("Index", "Home")" class="text-white-50">Home</a></li>
                        <li><a href="@Url.Action("Index", "Products")" class="text-white-50">Products</a></li>
                        <li><a href="@Url.Action("Index", "Cart")" class="text-white-50">Cart</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Categories</h6>
                    <ul class="list-unstyled">
                        <li><a href="@Url.Action("Index", "Products", new { category = "Sofas" })" class="text-white-50">Sofas</a></li>
                        <li><a href="@Url.Action("Index", "Products", new { category = "Beds" })" class="text-white-50">Beds</a></li>
                        <li><a href="@Url.Action("Index", "Products", new { category = "Tables" })" class="text-white-50">Tables</a></li>
                    </ul>
                </div>
            </div>
            <hr class="bg-white">
            <div class="text-center">
                <p class="small mb-0">&copy; 2026 WoodCraft Furniture. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
